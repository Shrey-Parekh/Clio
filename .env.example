# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- LLM ---
GEMINI_API_KEY=
JARVIS_LLM_MODEL=gemini-2.5-flash

# --- Speech ---
# edge | kokoro | elevenlabs | gemini
JARVIS_TTS_ENGINE=edge
JARVIS_TTS_VOICE=en-GB-RyanNeural
ELEVENLABS_API_KEY=

# faster-whisper model size: tiny | base | small | medium | large-v3
JARVIS_STT_MODEL=small.en
JARVIS_STT_DEVICE=cuda

# --- Wake word ---
JARVIS_WAKE_WORD=jarvis
JARVIS_WAKE_THRESHOLD=0.5

# --- Runtime ---
JARVIS_LOG_LEVEL=INFO
JARVIS_CORE_PORT=8765
