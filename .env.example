# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- LLM ---
# Provider must match a secret below: groq -> GROQ_API_KEY, gemini -> GEMINI_API_KEY.
CLIO_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Three tiers, picked per task rather than one model for everything - see config/default.toml.
CLIO_LLM_MODEL_FAST=openai/gpt-oss-20b
CLIO_LLM_MODEL_DEFAULT=openai/gpt-oss-120b
CLIO_LLM_MODEL_REASONING=openai/gpt-oss-120b
# Reasoning effort per tier: low | medium | high
CLIO_LLM_EFFORT_FAST=low
CLIO_LLM_EFFORT_DEFAULT=low
CLIO_LLM_EFFORT_REASONING=high
# Offline fallback - runs locally via Ollama, no network or billing needed.
CLIO_LLM_LOCAL_FALLBACK_MODEL=qwen3:8b
CLIO_LLM_LOCAL_FALLBACK_HOST=http://localhost:11434

# --- Speech ---
# edge | kokoro | elevenlabs | gemini
CLIO_TTS_ENGINE=kokoro
CLIO_TTS_VOICE=af_heart
ELEVENLABS_API_KEY=
# Kokoro model files - not committed. Download once:
#   https://github.com/thewh1teagle/kokoro-onnx releases -> model-files-v1.0
#   kokoro-v1.0.fp16-gpu.onnx (169MB) + voices-v1.0.bin (27MB) -> save into models/
CLIO_KOKORO_MODEL_PATH=models/kokoro-v1.0.fp16-gpu.onnx
CLIO_KOKORO_VOICES_PATH=models/voices-v1.0.bin

# local | groq - benchmarked equal accuracy, local is free/private/offline-capable.
CLIO_STT_PROVIDER=local
# faster-whisper model size: tiny | base | small | medium | large-v3
CLIO_STT_MODEL=small.en
CLIO_STT_DEVICE=cuda
CLIO_STT_GROQ_MODEL=whisper-large-v3-turbo

# --- Audio input / VAD ---
# Silero VAD, 16kHz variant, no torch - raw ONNX + onnxruntime (already installed
# for Kokoro). Download once (1.2MB):
#   https://raw.githubusercontent.com/snakers4/silero-vad/master/src/silero_vad/data/silero_vad_16k_op15.onnx
#   save into models/ as silero_vad_16k.onnx
CLIO_VAD_MODEL_PATH=models/silero_vad_16k.onnx
CLIO_VAD_THRESHOLD=0.5
CLIO_VAD_MIN_SPEECH_MS=250
CLIO_VAD_END_SILENCE_MS=700

# --- Wake word ---
# Comma-separated - any phrase in the list wakes Clio.
CLIO_WAKE_PHRASES=Hey Clio,Hi Clio,Hello Clio,Good morning Clio,Clio wake up
CLIO_WAKE_THRESHOLD=0.4
CLIO_WAKE_MODELS_DIR=models/wake_words

# --- Runtime ---
CLIO_LOG_LEVEL=INFO
CLIO_CORE_PORT=8765

# --- Persona ---
# Overrides config/default.toml's [persona] name only - the actual personality
# is persona.system_prompt in that file (or CLIO_PERSONA_SYSTEM_PROMPT here).
CLIO_PERSONA=Clio
