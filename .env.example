# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- LLM ---
GEMINI_API_KEY=
CLIO_LLM_MODEL=gemini-2.5-flash

# --- Speech ---
# edge | kokoro | elevenlabs | gemini
CLIO_TTS_ENGINE=edge
CLIO_TTS_VOICE=en-IE-EmilyNeural
ELEVENLABS_API_KEY=

# faster-whisper model size: tiny | base | small | medium | large-v3
CLIO_STT_MODEL=small.en
CLIO_STT_DEVICE=cuda

# --- Wake word ---
CLIO_WAKE_WORD=clio
CLIO_WAKE_THRESHOLD=0.5

# --- Runtime ---
CLIO_LOG_LEVEL=INFO
CLIO_CORE_PORT=8765

# --- Persona ---
# Friendly, quick-witted, lightly sarcastic. Concise by default.
CLIO_PERSONA=default
