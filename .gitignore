# Long-term memory data (transcripts, facts, derived index) - local, never committed.
# Anchored with a leading slash so it matches only the store at the project root,
# not the clio/memory/ source package.
/memory/

# Derived knowledge graph - rebuildable with `graphify update .`
graphify-out/

# Assistant config, same reasoning as .vscode/ and .idea/ above
.claude/
