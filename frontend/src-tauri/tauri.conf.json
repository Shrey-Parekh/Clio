{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clio",
  "version": "0.1.0",
  "identifier": "com.shrey.clio",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clio",
        "width": 420,
        "height": 560,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false
      },
      {
        "label": "panel",
        "title": "Clio — chat & settings",
        "url": "panel.html",
        "width": 500,
        "height": 660,
        "resizable": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ws://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
